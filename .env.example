GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
SITE_ORIGIN=http://localhost:3000
# Comma-separated platform-account emails allowed to use the admin portal.
# Required in production. Other signed-in users remain volunteers until they accept an event link.
RELAY_ORGANIZER_EMAILS=organizer@example.com
# 32 random bytes encoded as base64url (for example: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
TOKEN_ENCRYPTION_KEY=
# Use "mock" only for local acceptance testing. Production should use "gmail".
EMAIL_TRANSPORT=mock

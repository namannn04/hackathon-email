DATABASE_URL=

# Neon Console -> your project/branch -> Auth -> Configuration.
NEON_AUTH_BASE_URL=
# Informational/optional for services that verify Neon Auth JWTs directly.
NEON_AUTH_JWKS_URL=
# Stable secret of at least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated Neon Auth account emails that may open /admin.
RELAY_ORGANIZER_EMAILS=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Public origin with no trailing slash.
SITE_ORIGIN=http://localhost:3000

# 32 random bytes encoded as base64url:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
TOKEN_ENCRYPTION_KEY=

# "mock" is local-only acceptance testing; production must use "gmail".
EMAIL_TRANSPORT=mock

# Shown on the public home, privacy, and terms pages that Google's OAuth
# consent screen links to.
RELAY_CONTACT_EMAIL=
RELAY_LEGAL_ENTITY=
RELAY_GOVERNING_LAW=

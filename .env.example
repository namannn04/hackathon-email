# Neon database and authentication (same Neon branch)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-URL
NEON_AUTH_COOKIE_SECRET=replace-with-a-stable-secret-of-at-least-32-characters

# Comma-separated Relay organizer accounts
RELAY_ORGANIZER_EMAILS=organizer@example.com

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Public origin, without a trailing slash
SITE_ORIGIN=http://localhost:3000

# Generate 32 random bytes, encoded as base64url, and keep this value stable
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_BASE64URL_KEY

# Use mock locally; set gmail in Vercel/production
EMAIL_TRANSPORT=mock

# Public legal/contact details
RELAY_CONTACT_EMAIL=contact@example.com
RELAY_LEGAL_ENTITY=Your organization name
RELAY_GOVERNING_LAW=India
